{
  "name": "devconf-security",
  "version": "1.0.0",
  "private": true,
  "description": "Лабораторная работа № 31. Базовая безопасность лендинга DEVCONF 2026: sanitization вопроса спикеру, Helmet и CSP",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "local": "node scripts/local.js",
    "demo:unsafe": "SECURITY=off node scripts/local.js",
    "seed": "node scripts/seed.js",
    "seed:clear": "node scripts/seed.js --clear"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.1.0",
    "mongoose": "^8.8.0",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.7"
  },
  "engines": {
    "node": ">=18"
  },
  "nodemonConfig": {
    "ignore": [
      ".mongo-data/*"
    ]
  },
  "allowScripts": {
    "mongodb-memory-server@11.3.0": true
  }
}

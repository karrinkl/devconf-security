# Скопируйте этот файл под именем .env и подставьте свои значения.
# Файл .env в репозиторий не попадает: он указан в .gitignore.

# Порт, на котором поднимается Express
PORT=5000

# Защиту не отключать. SECURITY=off нужен только команде npm run demo:unsafe.

# Локальная MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/devconf

# Облачный кластер MongoDB Atlas (вместо строки выше)
# MONGO_URI=mongodb+srv://<пользователь>:<пароль>@<кластер>.mongodb.net/devconf?retryWrites=true&w=majority
